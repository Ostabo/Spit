{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Spit - Ollama Companion App",
  "version": "0.4.4",
  "identifier": "com.ostabo.spit",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Spit - Ollama Companion App",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQwNkE2N0YzRDZEN0Q5REYKUldUZjJkZlc4MmRxUUFQeG5OS3U4YzcrQnlXNzRISWIzdC8ycnErZFZrSnJDN05VZFNaQWppdXMK",
      "endpoints": [
        "https://github.com/Ostabo/Spit/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "basicUi"
      }
    }
  }
}